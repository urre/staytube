{
  "name": "staytube",
  "version": "1.1.0",
  "description": "Great full length concerts from YouTube",
  "main": "src/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/urre/staytube"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build && npm run build:assets && npm run sitemap",
    "build:assets": "cd src && cp -R images ../dist/",
    "format:js": "npx prettier --write './src/**/*.{js,jsx,mjs}'",
    "format:css": "npx stylelint './src/**/*.css' --fix",
    "format": "npm run format:js && npm run format:css",
    "sitemap": "cd src && node createsitemap.mjs",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "axios": "^1.0.0",
    "basscss": "^8.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-icons": "^5.0.0",
    "react-router-dom": "^5.3.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "2.1.2",
    "vite": "^7.0.0"
  }
}
