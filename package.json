{
  "name": "staytube",
  "version": "1.1.0",
  "description": "Great full length concerts from YouTube",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/urre/staytube"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build && cp dist/index.html dist/404.html && npm run sitemap",
    "preview": "vite preview",
    "format:js": "prettier --write './src/**/*.{js,jsx,mjs}' vite.config.mjs",
    "format:css": "stylelint './src/**/*.css' --fix",
    "format": "npm run format:js && npm run format:css",
    "sitemap": "cd src && node createsitemap.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "vite": "^8.3.5"
  }
}
